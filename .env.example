# Copy this file to .env and adjust. Every variable here is read by
# hwval.config.Settings (or, for the LLM API keys, by hwval.config.available_llm_keys
# and the LangChain provider SDKs directly). Nothing in this project requires
# an LLM key -- with none set, hwval.agent.llm falls back to a deterministic
# offline planner (RuleBasedChatModel) that runs the same LangGraph agent loop.

# ---- database ---------------------------------------------------------
# SQLAlchemy URL. Pick ONE of the examples below.

# Zero-infra local demo (no Postgres needed) -- what CI and a bare `hwval demo`
# run against unless you override it:
# DATABASE_URL=sqlite:///./artifacts/hwval.db

# Local/docker-compose Postgres:
DATABASE_URL=postgresql+psycopg2://hwval:hwval@localhost:5432/hwval

# Managed Postgres (Neon, Supabase, RDS, ...) -- note sslmode=require and that
# the password/host below are placeholders:
# DATABASE_URL=postgresql+psycopg2://neondb_owner:REPLACE_ME@ep-example-12345.us-east-2.aws.neon.tech/hwval?sslmode=require

DB_SCHEMA=public
SQL_ECHO=false

# ---- LLM ----------------------------------------------------------------
# auto | anthropic | openai | groq | google | ollama | rulebased
# "auto" picks the first provider below whose API key is set, else falls
# back to the offline rule-based planner.
LLM_PROVIDER=auto
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
AGENT_MAX_ITERATIONS=12

# Optional provider API keys -- set zero, one, or several. Only present keys
# are reported by hwval.config.available_llm_keys().
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
# Local Ollama server, e.g. http://localhost:11434
OLLAMA_BASE_URL=

# ---- safety ---------------------------------------------------------------
# The LLM never writes SQL that mutates data (see hwval.agent.tools) -- these
# just add extra guardrails around the read-only query tool and the
# maintenance-action tools.
SQL_READ_ONLY=true
SQL_ROW_LIMIT=500
MAINTENANCE_DRY_RUN=true

# ---- ML ---------------------------------------------------------------
ANOMALY_CONTAMINATION=0.08
SEQUENCE_LENGTH=32
RANDOM_SEED=42

# ---- paths --------------------------------------------------------------
# Where trained models, figures and reports are written (models/figures/reports
# subdirectories are created automatically).
ARTIFACTS_DIR=./artifacts
